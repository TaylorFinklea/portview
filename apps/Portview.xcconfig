// Portview shared build configuration — used by BOTH apps
// (apps/PortviewHost and apps/PortviewClient reference this file via
// `configFiles` in their project.yml).
//
// Zero-config default: the upstream maintainer's signing team and
// reverse-DNS bundle-id prefix.
//
// Building with your own Apple Developer team? Do NOT edit this file.
// Create `Portview.local.xcconfig` next to this file (gitignored) with:
//
//   PORTVIEW_DEVELOPMENT_TEAM = YOURTEAMID
//   PORTVIEW_BUNDLE_ID_PREFIX = com.yourdomain
//
// No `xcodegen generate` re-run is required after creating it — the
// override is picked up at build time.

PORTVIEW_DEVELOPMENT_TEAM = K7CBQW6MPG
PORTVIEW_BUNDLE_ID_PREFIX = dev.finklea

// Version single-source: bump BOTH apps (host + client) here. The generated
// Info.plists reference $(MARKETING_VERSION) / $(CURRENT_PROJECT_VERSION),
// substituted at build time — no `xcodegen generate` re-run needed.
MARKETING_VERSION = 1.0
CURRENT_PROJECT_VERSION = 1

// Optional per-developer override. Keep this include LAST so it wins.
#include? "Portview.local.xcconfig"
